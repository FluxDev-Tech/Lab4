<%- include('partials/header') %>
<section class="hero pt-5">
  <div class="container pt-lg-4">
    <div class="row align-items-center g-4 g-lg-5">
      <div class="col-12 col-lg-7">
        <span class="pill mb-3"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i> Student Portal</span>
        <h1 class="display-4 fw-bold text-white">Welcome,<br><span class="hl"><%= student.name %></span></h1>
        <p class="lead hero-sub mt-3"><%= student.course %></p>
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <a href="/services" class="btn btn-accent btn-lg">View Services <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          <a href="/about" class="btn btn-outline-light btn-lg">About the App</a>
        </div>
      </div>
      <div class="col-12 col-lg-5 align-self-end">
        <img class="hero-photo" src="/images/portrait.png" alt="Portrait of <%= student.name %>">
      </div>
    </div>
  </div>
</section>
<section class="container pt-5">
  <h2 class="h3 fw-bold">Services</h2>
  <p class="text-muted mb-4">Everything you need as a student, in one place.</p>
  <%- include('partials/cards', { compact: true }) %>
</section>
<%- include('partials/footer') %>
